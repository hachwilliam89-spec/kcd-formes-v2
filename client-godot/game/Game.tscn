[gd_scene format=3]

[ext_resource type="Script" path="res://game/Game.gd" id="1_game"]
[ext_resource type="Script" path="res://game/map/MapView.gd" id="2_mapview"]
[ext_resource type="Resource" path="res://visuals/map_palette_default.tres" id="3_palette"]
[ext_resource type="Script" path="res://game/battle/BattleView.gd" id="4_battle"]
[ext_resource type="Resource" path="res://visuals/visual_catalog.tres" id="5_catalog"]
[ext_resource type="Script" path="res://game/TickPlayer.gd" id="6_ticks"]

[node name="Game" type="Panel"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Screen"
script = ExtResource("1_game")

[node name="TickPlayer" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("6_ticks")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MapArea" type="Control" parent="Layout"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3

[node name="MapView" type="Node2D" parent="Layout/MapArea"]
unique_name_in_owner = true
script = ExtResource("2_mapview")
palette = ExtResource("3_palette")

[node name="BattleView" type="Node2D" parent="Layout/MapArea/MapView"]
unique_name_in_owner = true
script = ExtResource("4_battle")
catalog = ExtResource("5_catalog")

[node name="Fps" type="Label" parent="Layout/MapArea"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 4.0
offset_top = 2.0
theme_type_variation = &"FpsLabel"

[node name="Side" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Layout/Side"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Box" type="VBoxContainer" parent="Layout/Side/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="MapTitle" type="Label" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
autowrap_mode = 3

[node name="Stats" type="Label" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="TowerBar" type="GridContainer" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
columns = 3

[node name="WaveButton" type="Button" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Lancer la vague"
clip_text = true

[node name="BonusBox" type="VBoxContainer" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="Info" type="Label" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
autowrap_mode = 3

[node name="Back" type="Button" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FlatButton"
text = "Quitter"
