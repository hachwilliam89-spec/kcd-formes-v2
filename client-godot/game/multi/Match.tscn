[gd_scene format=3]

[ext_resource type="Script" path="res://game/multi/MatchScreen.gd" id="1_match"]
[ext_resource type="Script" path="res://game/map/MapView.gd" id="2_mapview"]
[ext_resource type="Resource" path="res://visuals/map_palette_default.tres" id="3_palette"]
[ext_resource type="Script" path="res://game/battle/BattleView.gd" id="4_battle"]
[ext_resource type="Resource" path="res://visuals/visual_catalog.tres" id="5_catalog"]
[ext_resource type="Script" path="res://game/TickPlayer.gd" id="6_ticks"]
[ext_resource type="Script" path="res://game/TowerBar.gd" id="7_towerbar"]
[ext_resource type="Script" path="res://game/multi/ChatBox.gd" id="8_chat"]

[node name="Match" type="Panel"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Screen"
script = ExtResource("1_match")

[node name="TickPlayer" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("6_ticks")

[node name="Layout" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MapArea" type="Control" parent="Layout"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3

[node name="MapView" type="Node2D" parent="Layout/MapArea"]
unique_name_in_owner = true
script = ExtResource("2_mapview")
palette = ExtResource("3_palette")

[node name="BattleView" type="Node2D" parent="Layout/MapArea/MapView"]
unique_name_in_owner = true
script = ExtResource("4_battle")
catalog = ExtResource("5_catalog")

[node name="Fps" type="Label" parent="Layout/MapArea"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 4.0
offset_top = 2.0
theme_type_variation = &"FpsLabel"

[node name="EndPanel" type="PanelContainer" parent="Layout/MapArea"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(280, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = -80.0
offset_right = 140.0
offset_bottom = 80.0
grow_horizontal = 2
grow_vertical = 2

[node name="EndBox" type="VBoxContainer" parent="Layout/MapArea/EndPanel"]
layout_mode = 2

[node name="EndTitle" type="Label" parent="Layout/MapArea/EndPanel/EndBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Le château est tombé"
horizontal_alignment = 1

[node name="EndSummary" type="Label" parent="Layout/MapArea/EndPanel/EndBox"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3

[node name="Replay" type="Button" parent="Layout/MapArea/EndPanel/EndBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Nouvelle partie"

[node name="Home" type="Button" parent="Layout/MapArea/EndPanel/EndBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"FlatButton"
text = "Accueil"

[node name="Side" type="PanelContainer" parent="Layout"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Layout/Side"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Box" type="VBoxContainer" parent="Layout/Side/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Title" type="Label" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "Multijoueur"
autowrap_mode = 3

[node name="Status" type="Label" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
autowrap_mode = 3

[node name="Lobby" type="VBoxContainer" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2

[node name="Create" type="Button" parent="Layout/Side/Scroll/Box/Lobby"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "Créer une partie"

[node name="JoinRow" type="HBoxContainer" parent="Layout/Side/Scroll/Box/Lobby"]
unique_name_in_owner = true
layout_mode = 2

[node name="Code" type="LineEdit" parent="Layout/Side/Scroll/Box/Lobby/JoinRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Code"
max_length = 8

[node name="Join" type="Button" parent="Layout/Side/Scroll/Box/Lobby/JoinRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "Rejoindre"

[node name="Players" type="Label" parent="Layout/Side/Scroll/Box/Lobby"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Ready" type="Button" parent="Layout/Side/Scroll/Box/Lobby"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "Je suis prêt"

[node name="Start" type="Button" parent="Layout/Side/Scroll/Box/Lobby"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Démarrer"

[node name="Play" type="VBoxContainer" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="Stats" type="Label" parent="Layout/Side/Scroll/Box/Play"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="TowerBar" type="GridContainer" parent="Layout/Side/Scroll/Box/Play"]
unique_name_in_owner = true
layout_mode = 2
columns = 3
script = ExtResource("7_towerbar")

[node name="BonusBox" type="VBoxContainer" parent="Layout/Side/Scroll/Box/Play"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="Chat" type="VBoxContainer" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2
script = ExtResource("8_chat")

[node name="Info" type="Label" parent="Layout/Side/Scroll/Box"]
unique_name_in_owner = true
layout_mode = 2
